{
      "name": "dogma-web",
      "version": "0.1.0",
      "private": true,
      "dependencies": {
            "@dagrejs/dagre": "^3.0.0",
            "@fontsource-variable/geist": "^5.2.9",
            "@fontsource-variable/geist-mono": "^5.2.8",
            "@lexical/react": "^0.45.0",
            "@radix-ui/react-accordion": "^1.2.3",
            "@radix-ui/react-alert-dialog": "^1.1.6",
            "@radix-ui/react-aspect-ratio": "^1.1.2",
            "@radix-ui/react-avatar": "^1.1.3",
            "@radix-ui/react-checkbox": "^1.1.4",
            "@radix-ui/react-collapsible": "^1.1.3",
            "@radix-ui/react-context-menu": "^2.2.6",
            "@radix-ui/react-dialog": "^1.1.6",
            "@radix-ui/react-dropdown-menu": "^2.1.6",
            "@radix-ui/react-hover-card": "^1.1.6",
            "@radix-ui/react-label": "^2.1.2",
            "@radix-ui/react-menubar": "^1.1.6",
            "@radix-ui/react-navigation-menu": "^1.2.5",
            "@radix-ui/react-popover": "^1.1.6",
            "@radix-ui/react-progress": "^1.1.2",
            "@radix-ui/react-radio-group": "^1.2.3",
            "@radix-ui/react-scroll-area": "^1.2.3",
            "@radix-ui/react-select": "^2.1.6",
            "@radix-ui/react-separator": "^1.1.2",
            "@radix-ui/react-slider": "^1.2.3",
            "@radix-ui/react-slot": "^1.1.2",
            "@radix-ui/react-switch": "^1.1.3",
            "@radix-ui/react-tabs": "^1.1.3",
            "@radix-ui/react-toggle": "^1.1.2",
            "@radix-ui/react-toggle-group": "^1.1.2",
            "@radix-ui/react-tooltip": "^1.1.8",
            "@xyflow/react": "^12.11.0",
            "class-variance-authority": "^0.7.1",
            "clsx": "*",
            "cmdk": "^1.1.1",
            "embla-carousel-react": "^8.6.0",
            "input-otp": "^1.4.2",
            "lexical": "^0.45.0",
            "lucide-react": "^0.487.0",
            "next-themes": "^0.4.6",
            "react": "^18.3.1",
            "react-day-picker": "^8.10.1",
            "react-dom": "^18.3.1",
            "react-hook-form": "^7.55.0",
            "react-markdown": "*",
            "react-resizable-panels": "^2.1.7",
            "react-router-dom": "^6.30.4",
            "recharts": "^2.15.2",
            "sonner": "^2.0.3",
            "tailwind-merge": "*",
            "vaul": "^1.1.2"
      },
      "devDependencies": {
            "@tailwindcss/vite": "^4.3.1",
            "@testing-library/dom": "^10.4.1",
            "@testing-library/jest-dom": "^6.9.1",
            "@testing-library/react": "^16.3.2",
            "@types/node": "^20.10.0",
            "@vitejs/plugin-react-swc": "^3.10.2",
            "electron": "^43.2.0",
            "electron-builder": "^26.15.3",
            "jsdom": "^29.1.1",
            "tailwindcss": "^4.3.1",
            "tw-animate-css": "^1.4.0",
            "typescript": "~5.6",
            "vite": "6.4.3",
            "vitest": "^4.1.8"
      },
      "main": "electron/main.js",
      "scripts": {
            "dev": "vite",
            "build": "vite build",
            "test": "vitest run",
            "typecheck": "tsc --noEmit",
            "electron": "node electron/run.js",
            "electron:dev": "node electron/dev.js",
            "electron:smoke": "node electron/smoke.js",
            "electron:smoke:dev": "node electron/dev.js --smoke",
            "icon": "electron/assets/make-icon.sh",
            "package": "npm run build && node electron/bake-repo-root.js && electron-builder --mac --dir",
            "test:electron": "node --test \"electron/test/*.test.js\""
      },
      "build": {
            "appId": "dev.manutej.dogma",
            "productName": "dogma",
            "copyright": "Copyright © Manu Arrojwala",
            "directories": {
                  "output": "dist",
                  "buildResources": "electron/assets"
            },
            "files": [
                  "electron/**/*",
                  "build/**/*",
                  "package.json",
                  "!electron/test/**",
                  "!**/*.map"
            ],
            "asar": false,
            "afterPack": "electron/after-pack.js",
            "mac": {
                  "icon": "electron/assets/icon.icns",
                  "category": "public.app-category.developer-tools",
                  "identity": null,
                  "target": [
                        "dir"
                  ],
                  "extendInfo": {
                        "CFBundleName": "dogma",
                        "CFBundleDisplayName": "dogma"
                  }
            }
      }
}
