# Dogma environment variables (`QURATION__*` names are compatibility identifiers)
# Copy this file to .env and fill in your values

# Anthropic API key (required only for live Anthropic-backed features)
ANTHROPIC_API_KEY=your-api-key-here

# NCBI E-utilities (required for GEO access)
# Register at: https://www.ncbi.nlm.nih.gov/account/
QURATION__DATA_SOURCES__GEO__EMAIL=your-email@example.com
QURATION__DATA_SOURCES__GEO__API_KEY=  # Optional, increases rate limits

# AWS Bedrock (optional, for using AWS credits)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# GCP Vertex AI (optional, for using GCP credits)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# QURATION__LLM__GCP_VERTEX__PROJECT_ID=your-project-id

# Cost tracking
QURATION__COST_TRACKING__ENABLED=true
QURATION__COST_TRACKING__BUDGET_ALERT_THRESHOLD=100.0

# Logging
QURATION__LOGGING__LEVEL=INFO
